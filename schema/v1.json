{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operatorstack:pitot:protocol:v1",
  "title": "Pitot v1 envelope",
  "$comment": "This schema validates decoded JSON values. The separate transport profile requires strict UTF-8, Unicode scalar strings, unique object member names at every depth including request data, one top-level object, and integer lexical spelling for usage counters (no decimal point or exponent). JSON Schema integer is mathematical and therefore accepts 1.0 and 1e0. Frames are limited to 4 MiB excluding their LF delimiter (CRLF accepted), with maximum object/array depth 128. Blank ASCII JSON whitespace frames are skipped and nonempty final EOF frames are accepted. These byte and lexical rules are not JSON Schema assertions.",
  "oneOf": [
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/fault"
    }
  ],
  "$defs": {
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "kind"],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "source": {
          "enum": ["host_hook", "host_event"]
        },
        "fidelity": {
          "enum": ["direct", "estimated"]
        }
      },
      "required": ["source", "fidelity"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "full"
            },
            "full": {
              "type": "string"
            }
          },
          "required": ["mode", "full"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "sha256"
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          },
          "required": ["mode", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "omit"
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "pitot_version": {
          "const": "1"
        },
        "type": {
          "enum": ["action.requested", "model.usage"]
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "id": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": ["pitot_version", "type", "host", "observation"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "action.requested"
              }
            }
          },
          "then": {
            "required": ["action"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "model.usage"
              }
            }
          },
          "then": {
            "required": ["usage"]
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "pitot_version": {
          "const": "1"
        },
        "type": {
          "const": "control.requested"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {}
      },
      "required": ["pitot_version", "type", "kind", "action_id"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "pitot_version": {
          "const": "1"
        },
        "type": {
          "const": "control.response"
        },
        "controller_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": ["allow", "deny"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "pitot_version",
        "type",
        "controller_id",
        "action_id",
        "outcome"
      ],
      "additionalProperties": false
    },
    "fault": {
      "type": "object",
      "properties": {
        "pitot_version": {
          "const": "1"
        },
        "type": {
          "const": "boundary.fault"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string"
        },
        "reason": {
          "enum": ["empty-command", "malformed-event", "unsupported-host"]
        }
      },
      "required": ["pitot_version", "type", "host", "reason"],
      "additionalProperties": false
    }
  }
}
